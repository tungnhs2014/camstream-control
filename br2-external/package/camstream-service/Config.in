config BR2_PACKAGE_CAMSTREAM_SERVICE
	bool "camstream-service"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_PACKAGE_GSTREAMER1
	depends on BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE
	depends on BR2_PACKAGE_GST1_PLUGINS_GOOD
	depends on BR2_PACKAGE_GST1_PLUGINS_GOOD_JPEG
	depends on BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2
	help
	  Foreground Camera Service owning the reusable native-GStreamer
	  V4L2 pipeline for CamStream Control.

comment "camstream-service needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
